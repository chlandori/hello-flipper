# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="hello_flipper",  # Must be unique
    name="Hello Flipper",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="hello_flipper_app",
    stack_size=1 * 1024,
    fap_category="Examples",
    # Explicit list keeps the build from globbing the local venv/ folder
    sources=["hello_flipper.c"],
    # Optional values
    # fap_version="0.1",
    fap_icon="hello_flipper.png",  # 10x10 1-bit PNG
    # fap_description="A simple app",
    # fap_author="J. Doe",
    # fap_weburl="https://github.com/user/hello_flipper",
    fap_icon_assets="images",  # Image assets to compile for this application
)
